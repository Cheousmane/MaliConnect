# MaliConnect — configuration locale d'exemple
#
# Copier ce fichier puis générer la clé applicative :
#   cp .env.example .env
#   php artisan key:generate
#
# Les valeurs par défaut ciblent un poste de développement (SQLite, mail log).
# Pour la production, renseigner APP_ENV, APP_DEBUG, APP_URL, la base et le mail.

APP_NAME=MaliConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Bamako
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite par défaut : aucun service externe n'est nécessaire en local.
DB_CONNECTION=sqlite
# DB_DATABASE est laissé vide : config/database.php utilise database/database.sqlite.
# DB_DATABASE=
#
# PostgreSQL (production ou CI) :
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=maliconnect
# DB_USERNAME=maliconnect
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Mail : « log » écrit les messages dans les logs en développement.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Canaux de notification : « database » alimente le centre de notifications.
# Ajouter « mail » pour envoyer aussi les notifications par e-mail.
NOTIFICATION_CHANNELS=database

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Abonnements et paiements manuels
# ---------------------------------------------------------------------------

# Délai de grâce (jours) après l'échéance avant expiration effective.
SUBSCRIPTION_GRACE_DAYS=7

# Nombre de jours avant l'échéance pour envoyer le rappel de renouvellement.
SUBSCRIPTION_REMINDER_DAYS=7

# Devise de référence de la plateforme.
SUBSCRIPTION_CURRENCY=XOF

# Instructions affichées aux professionnels avant l'envoi d'une preuve.
SUBSCRIPTION_PAYMENT_INSTRUCTIONS="Effectuez le paiement au numéro Orange Money officiel de MaliConnect, puis joignez une capture ou un reçu lisible. Votre abonnement ne sera activé qu'après vérification par notre équipe."

# Disque privé de stockage des preuves de paiement.
SUBSCRIPTION_PROOF_DISK=local

# Taille maximale d'une preuve de paiement (Ko).
SUBSCRIPTION_PROOF_MAX_KB=5120

# Passerelle par défaut pour les paiements manuels.
SUBSCRIPTION_DEFAULT_GATEWAY=manual

# ---------------------------------------------------------------------------
# Services optionnels (décommenter si utilisés)
# ---------------------------------------------------------------------------

# Redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Stockage compatible S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Diffusion temps réel
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
